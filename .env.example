# Copy to .env.local and fill in. Never commit real values.

# 'mock' (no Google, in-memory) or 'live'. Default: mock.
GOOGLE_MODE=
# 'memory' or 'supabase'. Default: memory in mock mode, supabase in live mode.
STORE=
# base64 of 32 random bytes (AES-256-GCM key for stored secrets).
ENCRYPTION_KEY=
# At least 32 random characters; signs the admin session cookie.
SESSION_SECRET=
# At least 32 random characters; signs pagination cursors.
CURSOR_SECRET=
# Comma-separated emails allowed to sign in to /connect.
ADMIN_EMAILS=
# Google OAuth client used only for admin sign-in (openid email).
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
# Supabase project URL and service-role key (server only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public origin of this server, e.g. https://mcp.stratifysoftware.com
PUBLIC_BASE_URL=
# Shared secret for scheduled (cron) endpoints.
CRON_SECRET=
